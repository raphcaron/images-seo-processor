ANTHROPIC_API_KEY=sk-ant-...

# Optionnel — pour le modèle gratuit Google Gemini Flash.
# Clé gratuite: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optionnel — pour le modèle local Qwen3-VL via Ollama (gratuit, illimité).
# Laisser vide si Ollama tourne en local sur le port par défaut (11434).
OLLAMA_URL=

# Les identifiants WordPress/Shopify se configurent désormais depuis
# l'interface web (carte "Destinations"), pas via .env.
